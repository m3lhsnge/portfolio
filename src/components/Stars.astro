<!-- Twinkling Stars Canvas Background -->
<canvas id="starfield" aria-hidden="true"></canvas>

<style>
	#starfield {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: 0;
		pointer-events: none;
	}
</style>

<script>
	const canvas = document.getElementById('starfield') as HTMLCanvasElement;
	const ctx = canvas.getContext('2d')!;

	interface Star {
		x: number;
		y: number;
		radius: number;
		opacity: number;
		speed: number;
		direction: number; // 1 = brightening, -1 = dimming
		color: string;
	}

	let stars: Star[] = [];
	let width = window.innerWidth;
	let height = window.innerHeight;
	let dpr = 1;
	let animationFrameId: number;
	let shootingStarTimeout: number;

	const starColors = [
		'255, 255, 255',   // white
		'200, 220, 255',   // cool blue-white
		'255, 240, 220',   // warm white
		'180, 200, 255',   // light blue
		'255, 210, 180',   // pale orange
		'220, 200, 255',   // lavender
	];

	const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	function getStarCount(): number {
		const area = window.innerWidth * window.innerHeight;
		const count = Math.floor(area / 9500);
		return Math.max(60, Math.min(count, 300));
	}

	function createStar(): Star {
		return {
			x: Math.random() * width,
			y: Math.random() * height,
			radius: Math.random() * 1.6 + 0.3,
			opacity: Math.random() * 0.9 + 0.1,
			speed: Math.random() * 0.007 + 0.002,
			direction: Math.random() > 0.5 ? 1 : -1,
			color: starColors[Math.floor(Math.random() * starColors.length)],
		};
	}

	function resizeCanvas(recreateStars = true): void {
		dpr = Math.min(window.devicePixelRatio || 1, 2);
		width = window.innerWidth;
		height = window.innerHeight;

		canvas.width = Math.floor(width * dpr);
		canvas.height = Math.floor(height * dpr);
		canvas.style.width = `${width}px`;
		canvas.style.height = `${height}px`;

		ctx.setTransform(1, 0, 0, 1, 0, 0);
		ctx.scale(dpr, dpr);

		if (recreateStars || stars.length === 0) {
			const count = getStarCount();
			stars = Array.from({ length: count }, () => createStar());
		}
	}

	function drawStar(star: Star): void {
		// Glow effect
		const glowRadius = star.radius * 2.8;
		const gradient = ctx.createRadialGradient(
			star.x, star.y, 0,
			star.x, star.y, glowRadius
		);
		gradient.addColorStop(0, `rgba(${star.color}, ${star.opacity})`);
		gradient.addColorStop(0.4, `rgba(${star.color}, ${star.opacity * 0.25})`);
		gradient.addColorStop(1, `rgba(${star.color}, 0)`);

		ctx.beginPath();
		ctx.arc(star.x, star.y, glowRadius, 0, Math.PI * 2);
		ctx.fillStyle = gradient;
		ctx.fill();

		// Core
		ctx.beginPath();
		ctx.arc(star.x, star.y, star.radius, 0, Math.PI * 2);
		ctx.fillStyle = `rgba(${star.color}, ${star.opacity})`;
		ctx.fill();
	}

	function animate(): void {
		ctx.clearRect(0, 0, width, height);

		for (const star of stars) {
			star.opacity += star.speed * star.direction;

			if (star.opacity >= 1) {
				star.opacity = 1;
				star.direction = -1;
			} else if (star.opacity <= 0.05) {
				star.opacity = 0.05;
				star.direction = 1;
			}

			drawStar(star);
		}

		if (!prefersReducedMotion) {
			animationFrameId = requestAnimationFrame(animate);
		}
	}

	// Shooting star animation
	function shootingStar(): void {
		if (prefersReducedMotion) return;

		const startX = Math.random() * width;
		const startY = Math.random() * height * 0.45;
		const isMobile = width < 768;
		const length = Math.random() * (isMobile ? 80 : 130) + 40;
		const angle = Math.PI / 4 + (Math.random() * 0.3 - 0.15);
		const speed = isMobile ? 6 : 8;
		let progress = 0;

		function drawShootingStar(): void {
			if (progress > length + 40) return;

			const currentX = startX + Math.cos(angle) * progress;
			const currentY = startY + Math.sin(angle) * progress;
			const tailX = startX + Math.cos(angle) * Math.max(0, progress - 40);
			const tailY = startY + Math.sin(angle) * Math.max(0, progress - 40);

			const gradient = ctx.createLinearGradient(tailX, tailY, currentX, currentY);
			gradient.addColorStop(0, 'rgba(255, 255, 255, 0)');
			gradient.addColorStop(1, `rgba(255, 255, 255, ${Math.max(0, 1 - progress / (length + 40))})`);

			ctx.beginPath();
			ctx.moveTo(tailX, tailY);
			ctx.lineTo(currentX, currentY);
			ctx.strokeStyle = gradient;
			ctx.lineWidth = isMobile ? 1.2 : 1.5;
			ctx.stroke();

			progress += speed;
			requestAnimationFrame(drawShootingStar);
		}

		drawShootingStar();
	}

	function scheduleShootingStar(): void {
		if (prefersReducedMotion) return;
		const delay = Math.random() * 6000 + 3500;
		shootingStarTimeout = window.setTimeout(() => {
			shootingStar();
			scheduleShootingStar();
		}, delay);
	}

	// Initialize
	resizeCanvas(true);
	if (prefersReducedMotion) {
		// Just draw once
		for (const star of stars) {
			drawStar(star);
		}
	} else {
		animate();
		scheduleShootingStar();
	}

	// Handle window resize and mobile orientation changes
	let lastWidth = window.innerWidth;
	let lastHeight = window.innerHeight;
	let resizeTimeout: number;

	function handleResize(): void {
		window.clearTimeout(resizeTimeout);
		resizeTimeout = window.setTimeout(() => {
			const newWidth = window.innerWidth;
			const newHeight = window.innerHeight;

			// If width changed significantly (or orientation change), re-create stars
			const widthChanged = Math.abs(newWidth - lastWidth) > 10;
			const heightChangedSignificantly = Math.abs(newHeight - lastHeight) > 120;

			if (widthChanged || heightChangedSignificantly) {
				lastWidth = newWidth;
				lastHeight = newHeight;
				resizeCanvas(true);
				if (prefersReducedMotion) {
					ctx.clearRect(0, 0, width, height);
					for (const star of stars) {
						drawStar(star);
					}
				}
			} else {
				// Minor height shift (e.g. mobile address bar show/hide)
				resizeCanvas(false);
			}
		}, 120);
	}

	window.addEventListener('resize', handleResize, { passive: true });
	window.addEventListener('orientationchange', () => {
		setTimeout(handleResize, 150);
	}, { passive: true });
</script>
