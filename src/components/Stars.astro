<!-- Düşük donanımlı cihazlar için uyarlanmış yıldız alanı -->
<canvas id="starfield" aria-hidden="true"></canvas>

<style>
	#starfield {
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100%;
		z-index: 0;
		pointer-events: none;
		opacity: .92;
	}
</style>

<script>
	const canvas = document.querySelector<HTMLCanvasElement>('#starfield');
	const context = canvas?.getContext('2d', { alpha: true });

	if (canvas && context) {
		interface Star {
			x: number;
			y: number;
			radius: number;
			opacity: number;
			speed: number;
			direction: 1 | -1;
			color: string;
		}

		interface Meteor {
			x: number;
			y: number;
			progress: number;
			length: number;
			speed: number;
			angle: number;
		}

		const colors = ['255,255,255', '226,232,242', '244,238,226', '210,220,236'];
		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const deviceMemory = (navigator as Navigator & { deviceMemory?: number }).deviceMemory ?? 4;
		const lowPower = deviceMemory <= 4 || (navigator.hardwareConcurrency ?? 4) <= 4;
		const targetFps = lowPower ? 20 : 30;
		const frameInterval = 1000 / targetFps;
		let width = 0;
		let height = 0;
		let ratio = 1;
		let lastFrame = 0;
		let frameId = 0;
		let resizeTimer = 0;
		let stars: Star[] = [];
		let meteor: Meteor | null = null;
		let nextMeteor = performance.now() + 5000 + Math.random() * 5000;

		const starCount = () => {
			const count = Math.floor((width * height) / (lowPower ? 17000 : 14500));
			return Math.max(48, Math.min(count, lowPower ? 82 : 160));
		};

		const createStar = (): Star => ({
			x: Math.random() * width,
			y: Math.random() * height,
			radius: Math.random() * 1.2 + .22,
			opacity: Math.random() * .78 + .12,
			speed: Math.random() * .007 + .002,
			direction: Math.random() > .5 ? 1 : -1,
			color: colors[Math.floor(Math.random() * colors.length)],
		});

		const resize = (rebuild = true) => {
			width = window.innerWidth;
			height = window.innerHeight;
			ratio = Math.min(window.devicePixelRatio || 1, lowPower ? 1.25 : 1.75);
			canvas.width = Math.floor(width * ratio);
			canvas.height = Math.floor(height * ratio);
			canvas.style.width = `${width}px`;
			canvas.style.height = `${height}px`;
			context.setTransform(ratio, 0, 0, ratio, 0, 0);
			if (rebuild || !stars.length) stars = Array.from({ length: starCount() }, createStar);
		};

		const draw = (time: number, update = true) => {
			context.clearRect(0, 0, width, height);
			for (const star of stars) {
				if (update) {
					star.opacity += star.speed * star.direction;
					if (star.opacity >= .92 || star.opacity <= .12) star.direction *= -1;
				}
				if (star.radius > 1.05) {
					context.beginPath();
					context.arc(star.x, star.y, star.radius * 2.4, 0, Math.PI * 2);
					context.fillStyle = `rgba(${star.color},${star.opacity * .08})`;
					context.fill();
				}
				context.beginPath();
				context.arc(star.x, star.y, star.radius, 0, Math.PI * 2);
				context.fillStyle = `rgba(${star.color},${star.opacity})`;
				context.fill();
			}

			if (!reducedMotion && !lowPower && time >= nextMeteor && !meteor) {
				meteor = {
					x: Math.random() * width * .75,
					y: Math.random() * height * .3,
					progress: 0,
					length: 90 + Math.random() * 60,
					speed: 9,
					angle: Math.PI / 4,
				};
			}

			if (meteor) {
				const currentX = meteor.x + Math.cos(meteor.angle) * meteor.progress;
				const currentY = meteor.y + Math.sin(meteor.angle) * meteor.progress;
				const tail = Math.max(0, meteor.progress - 55);
				const tailX = meteor.x + Math.cos(meteor.angle) * tail;
				const tailY = meteor.y + Math.sin(meteor.angle) * tail;
				const gradient = context.createLinearGradient(tailX, tailY, currentX, currentY);
				gradient.addColorStop(0, 'rgba(180,210,255,0)');
				gradient.addColorStop(1, 'rgba(230,240,255,.8)');
				context.beginPath();
				context.moveTo(tailX, tailY);
				context.lineTo(currentX, currentY);
				context.strokeStyle = gradient;
				context.lineWidth = 1.2;
				context.stroke();
				if (update) meteor.progress += meteor.speed;
				if (meteor.progress > meteor.length + 70) {
					meteor = null;
					nextMeteor = time + 6500 + Math.random() * 8000;
				}
			}
		};

		const animate = (time: number) => {
			frameId = requestAnimationFrame(animate);
			if (document.hidden || time - lastFrame < frameInterval) return;
			lastFrame = time;
			draw(time);
		};

		resize();
		if (reducedMotion) draw(performance.now(), false);
		else frameId = requestAnimationFrame(animate);

		window.addEventListener('resize', () => {
			window.clearTimeout(resizeTimer);
			resizeTimer = window.setTimeout(() => resize(true), 180);
		}, { passive: true });

		document.addEventListener('astro:before-swap', () => cancelAnimationFrame(frameId), { once: true });
	}
</script>
