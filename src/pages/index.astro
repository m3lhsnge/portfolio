---
import Layout from '../layouts/Layout.astro';
import Stars from '../components/Stars.astro';
---

<Layout>
	<Stars />

	<div class="page-wrapper">
		<!-- Top-left logo -->
		<header>
			<a href="/" class="logo" id="logo-link" aria-label="Melih Aka Ana Sayfa">melhakaa</a>
		</header>

		<!-- Hero Section -->
		<main>
			<div class="hero">
				<h1 class="hero-name">
					<span class="name-first">Melih</span>
					<span class="name-last">Aka</span>
				</h1>
				<p class="hero-title">Yazılım Mühendisi</p>
				<div class="hero-divider" aria-hidden="true"></div>

				<!-- Projects Button -->
				<a href="https://github.com/m3lhsnge?tab=repositories" target="_blank" rel="noopener noreferrer" class="action-btn" id="projects-link" aria-label="GitHub projelerime göz at">
					<svg xmlns="http://www.w3.org/2000/svg" class="action-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
						<polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
						<line x1="12" y1="22.08" x2="12" y2="12"></line>
					</svg>
					<span>Projelerime Göz At</span>
				</a>

				<!-- Social Links -->
				<div class="social-links" role="list">
					<!-- GitHub -->
					<a href="https://github.com/m3lhsnge" target="_blank" rel="noopener noreferrer" class="social-link" title="GitHub" id="social-github" aria-label="GitHub Profilim">
						<svg xmlns="http://www.w3.org/2000/svg" class="social-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
							<path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
						</svg>
					</a>

					<!-- LinkedIn -->
					<a href="https://www.linkedin.com/in/melih-aka-499889319/" target="_blank" rel="noopener noreferrer" class="social-link" title="LinkedIn" id="social-linkedin" aria-label="LinkedIn Profilim">
						<svg xmlns="http://www.w3.org/2000/svg" class="social-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
							<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
						</svg>
					</a>

					<!-- Instagram -->
					<a href="https://www.instagram.com/m3lhakaa/" target="_blank" rel="noopener noreferrer" class="social-link" title="Instagram" id="social-instagram" aria-label="Instagram Profilim">
						<svg xmlns="http://www.w3.org/2000/svg" class="social-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
							<path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
						</svg>
					</a>
				</div>
			</div>
		</main>
	</div>
</Layout>

<style>
	.page-wrapper {
		position: relative;
		z-index: 1;
		width: 100%;
		min-height: 100vh;
		min-height: 100dvh;
		display: flex;
		flex-direction: column;
		overflow-x: hidden;
	}

	/* ── Header / Logo ── */
	header {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		padding-top: max(1.25rem, env(safe-area-inset-top));
		padding-left: max(1.75rem, env(safe-area-inset-left));
		padding-right: max(1.75rem, env(safe-area-inset-right));
		padding-bottom: 1rem;
		z-index: 10;
		pointer-events: none;
		display: flex;
		align-items: center;
	}

	.logo {
		pointer-events: auto;
		display: inline-block;
		font-family: 'Space Grotesk', sans-serif;
		font-size: clamp(1.1rem, 2.5vw, 1.35rem);
		font-weight: 700;
		letter-spacing: 1.5px;
		color: rgba(255, 255, 255, 0.85);
		cursor: pointer;
		transition: color 0.3s ease, text-shadow 0.3s ease, transform 0.2s ease;
		text-transform: lowercase;
		user-select: none;
	}

	/* ── Hero Section ── */
	main {
		flex: 1;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		width: 100%;
		min-height: 100vh;
		min-height: 100dvh;
		padding-top: max(4.5rem, calc(env(safe-area-inset-top) + 3.5rem));
		padding-bottom: max(2rem, env(safe-area-inset-bottom));
		padding-left: max(1.25rem, env(safe-area-inset-left));
		padding-right: max(1.25rem, env(safe-area-inset-right));
		box-sizing: border-box;
	}

	.hero {
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		margin: auto 0;
		gap: clamp(0.35rem, 1.5vh, 0.65rem);
		animation: fadeInUp 1s cubic-bezier(0.16, 1, 0.3, 1) both;
		width: 100%;
		max-width: 800px;
	}

	.hero-name {
		font-family: 'Space Grotesk', sans-serif;
		font-size: clamp(2.4rem, 11vw, 5.5rem);
		font-weight: 700;
		letter-spacing: clamp(1px, 0.5vw, 3px);
		line-height: 1.08;
		display: flex;
		flex-direction: column;
		gap: 0;
		user-select: none;
		margin: 0;
	}

	.name-first {
		background: linear-gradient(135deg, #e0c3fc 0%, #8ec5fc 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.name-last {
		background: linear-gradient(135deg, #8ec5fc 0%, #4facfe 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.hero-title {
		font-size: clamp(0.85rem, 3.2vw, 1.35rem);
		font-weight: 300;
		color: rgba(255, 255, 255, 0.6);
		letter-spacing: clamp(2px, 0.8vw, 4.5px);
		text-transform: uppercase;
		margin-top: clamp(0.15rem, 0.8vh, 0.35rem);
	}

	.hero-divider {
		width: clamp(44px, 8vw, 64px);
		height: 2px;
		background: linear-gradient(90deg, transparent, #8ec5fc, transparent);
		margin: clamp(0.75rem, 2vh, 1.25rem) 0;
		border-radius: 2px;
	}

	/* ── Action Button ── */
	.action-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.6rem;
		padding: clamp(0.7rem, 1.8vh, 0.85rem) clamp(1.4rem, 4.5vw, 2.2rem);
		border: 1px solid rgba(142, 197, 252, 0.4);
		border-radius: 50px;
		font-family: 'Inter', sans-serif;
		font-size: clamp(0.82rem, 2.2vw, 0.95rem);
		font-weight: 500;
		letter-spacing: 0.8px;
		color: rgba(255, 255, 255, 0.9);
		background: rgba(142, 197, 252, 0.08);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		transition: background-color 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease, transform 0.25s ease, color 0.3s ease;
		cursor: pointer;
		max-width: 90vw;
		text-decoration: none;
		user-select: none;
	}

	.action-icon {
		width: clamp(16px, 3.5vw, 18px);
		height: clamp(16px, 3.5vw, 18px);
		flex-shrink: 0;
		transition: transform 0.3s ease;
	}

	/* ── Social Links ── */
	.social-links {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: clamp(0.85rem, 3.5vw, 1.35rem);
		margin-top: clamp(1rem, 2.8vh, 1.75rem);
		flex-wrap: wrap;
	}

	.social-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: clamp(48px, 12vw, 58px);
		height: clamp(48px, 12vw, 58px);
		border-radius: 50%;
		border: 1px solid rgba(255, 255, 255, 0.12);
		color: rgba(255, 255, 255, 0.55);
		background: rgba(255, 255, 255, 0.03);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		transition: color 0.3s ease, border-color 0.3s ease, background-color 0.3s ease, box-shadow 0.3s ease, transform 0.25s ease;
		cursor: pointer;
		touch-action: manipulation;
		user-select: none;
	}

	.social-icon {
		width: clamp(22px, 5.5vw, 28px);
		height: clamp(22px, 5.5vw, 28px);
		transition: transform 0.25s ease;
	}

	/* ── Hover interactions (Desktops & fine pointer devices) ── */
	@media (hover: hover) and (pointer: fine) {
		.logo:hover {
			color: #fff;
			text-shadow: 0 0 20px rgba(99, 102, 241, 0.6), 0 0 40px rgba(99, 102, 241, 0.3);
		}

		.action-btn:hover {
			background: rgba(142, 197, 252, 0.2);
			border-color: rgba(217, 217, 230, 0.7);
			box-shadow: 0 0 25px rgba(142, 197, 252, 0.25), 0 0 50px rgba(142, 197, 252, 0.12);
			transform: translateY(-2px);
			color: #fff;
		}

		.action-btn:hover .action-icon {
			transform: translateY(2px);
		}

		.social-link:hover {
			color: #fff;
			border-color: rgba(99, 102, 241, 0.6);
			background: rgba(99, 102, 241, 0.15);
			box-shadow: 0 0 22px rgba(99, 102, 241, 0.25);
			transform: translateY(-3px);
		}

		.social-link:hover .social-icon {
			transform: scale(1.08);
		}
	}

	/* ── Touch interactions (Mobile & touchscreens) ── */
	@media (hover: none) or (pointer: coarse) {
		.logo:active {
			opacity: 0.75;
		}

		.action-btn:active {
			background: rgba(142, 197, 252, 0.22);
			border-color: rgba(142, 197, 252, 0.6);
			transform: scale(0.97);
		}

		.social-link:active {
			background: rgba(99, 102, 241, 0.2);
			border-color: rgba(99, 102, 241, 0.6);
			transform: scale(0.94);
		}
	}

	/* ── Animations ── */
	@keyframes fadeInUp {
		from {
			opacity: 0;
			transform: translateY(24px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	/* ── Extra-Small Screens (Foldable outer screen / small phones < 360px) ── */
	@media (max-width: 360px) {
		header {
			padding-left: 1rem;
			padding-right: 1rem;
		}

		.hero-name {
			font-size: 2.1rem;
			letter-spacing: 1px;
		}

		.hero-title {
			font-size: 0.78rem;
			letter-spacing: 1.8px;
		}

		.action-btn {
			padding: 0.65rem 1.25rem;
			font-size: 0.8rem;
			gap: 0.45rem;
		}

		.social-links {
			gap: 0.75rem;
		}

		.social-link {
			width: 44px;
			height: 44px;
		}

		.social-icon {
			width: 20px;
			height: 20px;
		}
	}

	/* ── Short Heights & Mobile Landscape (< 560px height) ── */
	@media (max-height: 560px) {
		header {
			padding-top: max(0.5rem, env(safe-area-inset-top));
			padding-bottom: 0.4rem;
			padding-left: max(1.2rem, env(safe-area-inset-left));
		}

		.logo {
			font-size: 1.05rem;
		}

		main {
			padding-top: max(2.8rem, calc(env(safe-area-inset-top) + 2.2rem));
			padding-bottom: max(1rem, env(safe-area-inset-bottom));
			justify-content: center;
		}

		.hero {
			gap: 0.2rem;
		}

		.hero-name {
			font-size: clamp(1.8rem, 8vh, 2.6rem);
			line-height: 1.05;
		}

		.hero-title {
			font-size: clamp(0.72rem, 3.2vh, 0.95rem);
			letter-spacing: 2px;
			margin-top: 0.1rem;
		}

		.hero-divider {
			margin: 0.4rem 0;
			height: 1.5px;
			width: 40px;
		}

		.action-btn {
			padding: 0.45rem 1.3rem;
			font-size: 0.78rem;
			gap: 0.45rem;
		}

		.action-icon {
			width: 15px;
			height: 15px;
		}

		.social-links {
			margin-top: 0.55rem;
			gap: 0.75rem;
		}

		.social-link {
			width: 40px;
			height: 40px;
		}

		.social-icon {
			width: 20px;
			height: 20px;
		}
	}

	/* ── Ultra-Wide & Large Desktop Displays (>= 1600px) ── */
	@media (min-width: 1600px) {
		header {
			padding-top: 2rem;
			padding-left: 3rem;
		}

		.logo {
			font-size: 1.45rem;
		}

		.hero-name {
			font-size: 5.5rem;
		}

		.hero-title {
			font-size: 1.4rem;
			letter-spacing: 5px;
		}

		.action-btn {
			padding: 0.9rem 2.4rem;
			font-size: 1rem;
		}

		.social-link {
			width: 62px;
			height: 62px;
		}

		.social-icon {
			width: 30px;
			height: 30px;
		}
	}

	/* ── Accessibility: Reduced Motion ── */
	@media (prefers-reduced-motion: reduce) {
		.hero {
			animation: none;
		}

		.action-btn,
		.action-btn svg,
		.social-link,
		.social-icon,
		.logo {
			transition: none !important;
			transform: none !important;
		}
	}
</style>

<script>
	// Logo click → smooth refresh/reset to top
	document.getElementById('logo-link')?.addEventListener('click', (e) => {
		e.preventDefault();
		if (window.location.pathname === '/' && window.location.hash === '') {
			window.scrollTo({ top: 0, behavior: 'smooth' });
			window.location.reload();
		} else {
			window.location.href = '/';
		}
	});
</script>
