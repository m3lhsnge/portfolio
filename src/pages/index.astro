---
import Layout from '../layouts/Layout.astro';
import Stars from '../components/Stars.astro';

const projects = [
	{
		number: '01',
		category: 'Full-stack e-ticaret',
		title: 'Nordic Living',
		description: 'Ürün keşfinden hesap yönetimine, favorilerden yönetim paneline uzanan responsive bir mobilya mağazası demosu.',
		detail: 'Supabase Auth, PostgreSQL, Storage ve rol tabanlı erişim ile gerçek bir ürün akışının uçtan uca kurgusu.',
		technologies: ['React', 'TypeScript', 'Supabase', 'PostgreSQL'],
		href: 'https://github.com/m3lhsnge/furniture-store-demo',
		visual: 'commerce',
	},
	{
		number: '02',
		category: 'İş uygulaması',
		title: 'Boya Reçete Sistemi',
		description: 'Özel boya karışımları için reçete, anlık maliyet ve renk hesabını şube bazlı yetkilendirmeyle bir araya getiren demo.',
		detail: 'JWT yetkilendirme, async veri erişimi ve rol/şube sınırlarıyla tasarlanmış kapsamlı bir operasyon akışı.',
		technologies: ['FastAPI', 'PostgreSQL', 'SQLAlchemy', 'JavaScript'],
		href: 'https://github.com/m3lhsnge/boya-satis-uygulamasi-demo',
		visual: 'paint',
	},
	{
		number: '03',
		category: 'Mobil + gömülü sistem',
		title: 'Akıllı Yemleme Botu',
		description: 'Yerel Wi-Fi ağı üzerinden düşük gecikmeyle kontrol edilen, Flutter arayüzlü ESP8266 tabanlı bir RC yemleme botu.',
		detail: 'Mobil uygulama, telemetri, motor ve servo kontrolünü donanım-yazılım bütünlüğü içinde ele alan staj projesi.',
		technologies: ['Flutter', 'Dart', 'C++', 'ESP8266'],
		href: 'https://github.com/m3lhsnge/fishing_boat',
		visual: 'boat',
	},
];

const stack = [
	{ group: 'Arayüz', items: ['React', 'TypeScript', 'Astro', 'HTML / CSS'] },
	{ group: 'Backend', items: ['FastAPI', 'Spring Boot', 'REST API', 'Node.js'] },
	{ group: 'Veri', items: ['PostgreSQL', 'MSSQL', 'Supabase', 'SQLAlchemy'] },
	{ group: 'Diğer', items: ['Flutter', 'C++', 'ESP8266', 'Git / GitHub'] },
];
---

<Layout>
	<Stars />

	<div class="site-shell" id="top">
		<header class="site-header">
			<a href="#top" class="logo" aria-label="Melih Aka, ana sayfa">
				<span>melhakaa</span>
			</a>

			<nav class="desktop-nav" aria-label="Ana menü">
				<a href="#projects">Projeler</a>
				<a href="#stack">Teknolojiler</a>
				<a href="#about">Hakkımda</a>
				<a href="#contact" class="nav-contact">İletişim</a>
			</nav>

			<button class="menu-toggle" type="button" aria-label="Menüyü aç" aria-expanded="false" aria-controls="mobile-nav">
				<span></span><span></span>
			</button>
			<nav class="mobile-nav" id="mobile-nav" aria-label="Mobil menü" hidden>
				<a href="#projects">Projeler</a>
				<a href="#stack">Teknolojiler</a>
				<a href="#about">Hakkımda</a>
				<a href="#contact">İletişim</a>
			</nav>
		</header>

		<main>
			<section class="hero section" aria-labelledby="hero-title">
				<div class="hero-orbit orbit-one" aria-hidden="true"></div>
				<div class="hero-orbit orbit-two" aria-hidden="true"></div>
				<div class="hero-content">
					<p class="eyebrow reveal"><span></span> Yazılım mühendisi</p>
					<h1 id="hero-title" class="hero-name reveal">
						<span>Melih</span>
						<span class="gradient-text">Aka.</span>
					</h1>
					<p class="hero-intro reveal">Modern web uygulamaları, güvenilir backend sistemleri ve cihazlarla iletişim kuran dijital deneyimler geliştiriyorum.</p>
					<div class="hero-actions reveal">
						<a href="#projects" class="button button-primary">
							Projeleri incele
							<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
						</a>
						<a href="#contact" class="button button-ghost">İletişime geç</a>
					</div>
				</div>

				<a class="scroll-cue" href="#projects" aria-label="Projeler bölümüne geç">
					<span>Keşfet</span>
					<i aria-hidden="true"></i>
				</a>
			</section>

			<section class="projects section content-section" id="projects" aria-labelledby="projects-title">
				<div class="section-heading reveal">
					<div>
						<p class="eyebrow"><span></span> Seçili çalışmalar</p>
						<h2 id="projects-title">Fikri çalışan bir<br /><span class="gradient-text">ürüne dönüştürmek.</span></h2>
					</div>
					<p>Web, mobil ve gömülü sistemlerde; arayüzden veri katmanına kadar farklı problemlere ürettiğim çözümler.</p>
				</div>

				<div class="project-list">
					{projects.map((project) => (
						<article class="project-card reveal">
							<div class={`project-visual visual-${project.visual}`} aria-hidden="true">
								<div class="visual-grid"></div>
								{project.visual === 'commerce' && (
									<div class="commerce-ui">
										<div class="ui-top"><i></i><span></span><span></span></div>
										<div class="ui-product"><b></b><div><i></i><i></i><i></i></div></div>
										<div class="ui-cards"><i></i><i></i><i></i></div>
									</div>
								)}
								{project.visual === 'paint' && (
									<div class="paint-ui">
										<div class="paint-ring"><i></i></div>
										<div class="paint-bars"><i></i><i></i><i></i><i></i></div>
									</div>
								)}
								{project.visual === 'boat' && (
									<div class="boat-ui">
										<div class="radar"><i></i><b></b></div>
										<div class="telemetry"><i></i><i></i><i></i></div>
									</div>
								)}
								<span class="project-number">{project.number}</span>
							</div>

							<div class="project-copy">
								<p class="project-category">{project.category}</p>
								<h3>{project.title}</h3>
								<p class="project-description">{project.description}</p>
								<p class="project-detail">{project.detail}</p>
								<ul class="tech-tags" aria-label="Kullanılan teknolojiler">
									{project.technologies.map((technology) => <li>{technology}</li>)}
								</ul>
								<a class="project-link" href={project.href} target="_blank" rel="noopener noreferrer" aria-label={`${project.title} GitHub deposunu aç`}>
									GitHub'da incele
									<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>
								</a>
							</div>
						</article>
					))}
				</div>

				<a class="all-projects reveal" href="https://github.com/m3lhsnge?tab=repositories" target="_blank" rel="noopener noreferrer">
					<span>Tüm GitHub projeleri</span>
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
				</a>
			</section>

			<section class="stack section content-section" id="stack" aria-labelledby="stack-title">
				<div class="section-heading reveal">
					<div>
						<p class="eyebrow"><span></span> Araç seti</p>
						<h2 id="stack-title">Probleme göre doğru<br /><span class="gradient-text">teknoloji seçimi.</span></h2>
					</div>
					<p>Tek bir çerçeveye bağlı kalmadan, ürünün ihtiyacına uygun katmanlar ve sürdürülebilir çözümler.</p>
				</div>

				<div class="stack-grid reveal">
					{stack.map((stackGroup, index) => (
						<div class="stack-group">
							<span class="stack-index">0{index + 1}</span>
							<h3>{stackGroup.group}</h3>
							<ul>{stackGroup.items.map((item) => <li>{item}</li>)}</ul>
						</div>
					))}
				</div>
			</section>

			<section class="about section content-section" id="about" aria-labelledby="about-title">
				<div class="about-panel reveal">
					<div class="about-constellation" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
					<div class="about-label">
						<p class="eyebrow"><span></span> Hakkımda</p>
						<span class="about-code">geliştiriliyor · her platformda</span>
					</div>
					<div class="about-copy">
						<h2 id="about-title">Merakı, çalışan sistemlere <span class="gradient-text">dönüştürüyorum.</span></h2>
						<p>Farklı platformlarda ürün geliştirirken yalnızca ekranı değil; veri akışını, güvenliği, performansı ve gerçek kullanım koşullarını birlikte düşünüyorum.</p>
						<p>Projelerimi Redmi 9T üzerinde Termux ve GitHub kullanarak da geliştiriyorum. Kısıtlı bir ortamda üretmek; hafif, anlaşılır ve taşınabilir çözümler kurma yaklaşımımı güçlendiriyor.</p>
					</div>
				</div>
			</section>

			<section class="contact section content-section" id="contact" aria-labelledby="contact-title">
				<div class="contact-inner reveal">
					<p class="eyebrow"><span></span> Birlikte üretelim</p>
					<h2 id="contact-title">Bir fikrin mi var?<br /><span class="gradient-text">Bağlantı kuralım.</span></h2>
					<p>Yeni projeler, teknik fikir alışverişi ve işbirlikleri için bana LinkedIn veya GitHub üzerinden ulaşabilirsin.</p>
					<div class="contact-links">
						<a href="https://www.linkedin.com/in/melih-aka-499889319/" target="_blank" rel="noopener noreferrer" class="button button-primary">
							LinkedIn'de yaz
							<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>
						</a>
						<a href="https://github.com/m3lhsnge" target="_blank" rel="noopener noreferrer" class="button button-ghost">GitHub profili</a>
					</div>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<a href="#top" class="footer-brand">melhakaa</a>
			<p>© <span id="current-year">2026</span> Melih Aka. Özenle geliştirildi.</p>
			<div class="footer-links" aria-label="Sosyal bağlantılar">
				<a href="https://github.com/m3lhsnge" target="_blank" rel="noopener noreferrer">GitHub</a>
				<a href="https://www.linkedin.com/in/melih-aka-499889319/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
				<a href="https://www.instagram.com/m3lhakaa/" target="_blank" rel="noopener noreferrer">Instagram</a>
			</div>
		</footer>
	</div>
</Layout>

<style>
	:global(:root) {
		--bg: #030308;
		--surface: rgba(13, 15, 28, 0.72);
		--border: rgba(178, 198, 255, 0.13);
		--text: #f5f7ff;
		--muted: #989db2;
		--blue: #8ec5fc;
		--violet: #c8a7ff;
		--max-width: 1180px;
	}
	.site-shell { position: relative; z-index: 1; overflow: clip; }
	.section { position: relative; width: 100%; }
	.content-section { max-width: var(--max-width); margin: 0 auto; padding: 8rem 2rem; scroll-margin-top: 5rem; }
	.site-header { position: fixed; inset: 0 0 auto; z-index: 50; height: 76px; display: flex; align-items: center; justify-content: space-between; padding: max(.85rem, env(safe-area-inset-top)) max(2rem, env(safe-area-inset-right)) .85rem max(2rem, env(safe-area-inset-left)); background: linear-gradient(180deg, rgba(3,3,8,.86), rgba(3,3,8,0)); transition: background .3s ease, border-color .3s ease; }
	.site-header.is-scrolled { background: rgba(3,3,8,.82); border-bottom: 1px solid var(--border); backdrop-filter: blur(18px); }
	.logo { display: flex; align-items: center; gap: .7rem; font-family: 'Space Grotesk', sans-serif; font-weight: 700; letter-spacing: .08em; color: rgba(255,255,255,.9); }
	.logo-mark { display: grid; place-items: center; width: 30px; height: 30px; border: 1px solid rgba(142,197,252,.36); border-radius: 9px; font-size: .8rem; color: var(--blue); background: rgba(142,197,252,.06); box-shadow: inset 0 0 18px rgba(142,197,252,.08); }
	.desktop-nav { display: flex; align-items: center; gap: 2rem; font-size: .85rem; color: rgba(255,255,255,.62); }
	.desktop-nav a { transition: color .2s ease; }
	.desktop-nav a:hover, .desktop-nav a:focus-visible { color: #fff; }
	.nav-contact { padding: .65rem 1rem; border: 1px solid var(--border); border-radius: 999px; }
	.menu-toggle, .mobile-nav { display: none; }
	.hero { min-height: 100svh; display: grid; place-items: center; padding: 7rem 2rem 5rem; isolation: isolate; }
	.hero::before { content: ''; position: absolute; inset: 15%; z-index: -1; background: radial-gradient(circle, rgba(80,100,255,.1), transparent 58%); filter: blur(30px); }
	.hero-content { width: min(920px, 100%); text-align: center; }
	.eyebrow { display: flex; align-items: center; gap: .7rem; color: #b6bbcc; text-transform: uppercase; letter-spacing: .2em; font-size: .72rem; font-weight: 600; }
	.hero .eyebrow { justify-content: center; margin-bottom: 1.6rem; }
	.eyebrow span { width: 25px; height: 1px; background: linear-gradient(90deg, var(--blue), var(--violet)); box-shadow: 0 0 10px var(--blue); }
	.hero-name { font-size: clamp(4.2rem, 13vw, 9.3rem); line-height: .79; letter-spacing: -.075em; font-weight: 700; display: flex; flex-direction: column; align-items: center; }
	.hero-name span { display: block; }
	.gradient-text { color: transparent; background: linear-gradient(110deg, #f0ddff 5%, #a7ccff 48%, #78a8ff 100%); -webkit-background-clip: text; background-clip: text; }
	.hero-intro { max-width: 670px; margin: 2.4rem auto 0; color: var(--muted); font-size: clamp(1rem, 2vw, 1.2rem); line-height: 1.75; }
	.hero-actions { display: flex; justify-content: center; gap: .8rem; margin-top: 2.3rem; flex-wrap: wrap; }
	.button { min-height: 48px; display: inline-flex; align-items: center; justify-content: center; gap: .65rem; padding: .8rem 1.35rem; border-radius: 999px; font-size: .88rem; font-weight: 600; transition: transform .22s ease, border-color .22s ease, background .22s ease, box-shadow .22s ease; }
	.button svg, .project-link svg, .all-projects svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
	.button-primary { color: #0b0d16; background: linear-gradient(120deg, #d8c3ff, #8ec5fc); box-shadow: 0 10px 35px rgba(110,155,255,.18); }
	.button-ghost { color: rgba(255,255,255,.82); background: rgba(255,255,255,.035); border: 1px solid var(--border); backdrop-filter: blur(10px); }
	.button:hover { transform: translateY(-2px); }
	.button-primary:hover { box-shadow: 0 12px 38px rgba(110,155,255,.3); }
	.button-ghost:hover { background: rgba(255,255,255,.08); border-color: rgba(178,198,255,.3); }
	.scroll-cue { position: absolute; bottom: 1.6rem; left: 50%; transform: translateX(-50%); display: flex; flex-direction: column; align-items: center; gap: .7rem; color: #747a90; font-size: .62rem; letter-spacing: .22em; text-transform: uppercase; }
	.scroll-cue i { width: 1px; height: 36px; background: linear-gradient(var(--blue), transparent); animation: scrollPulse 2.2s ease-in-out infinite; }
	.hero-orbit { position: absolute; z-index: -1; border: 1px solid rgba(142,197,252,.06); border-radius: 50%; pointer-events: none; }
	.orbit-one { width: min(78vw, 820px); aspect-ratio: 1; }
	.orbit-two { width: min(52vw, 550px); aspect-ratio: 1; border-color: rgba(200,167,255,.07); }
	.section-heading { display: grid; grid-template-columns: minmax(0,1.25fr) minmax(260px,.75fr); gap: 4rem; align-items: end; margin-bottom: 4.5rem; }
	.section-heading .eyebrow { margin-bottom: 1.2rem; }
	.section-heading h2, .about h2, .contact h2 { font-size: clamp(2.25rem,5vw,4.5rem); line-height: 1.08; letter-spacing: -.05em; }
	.section-heading > p { color: var(--muted); line-height: 1.75; font-size: .98rem; max-width: 430px; justify-self: end; }
	.project-list { display: grid; gap: 1.4rem; }
	.project-card { display: grid; grid-template-columns: minmax(320px,1.02fr) minmax(320px,.98fr); min-height: 520px; overflow: hidden; border: 1px solid var(--border); border-radius: 28px; background: linear-gradient(145deg, rgba(18,20,35,.78), rgba(7,8,16,.84)); box-shadow: 0 24px 80px rgba(0,0,0,.25); }
	.project-card:nth-child(even) .project-visual { order: 2; }
	.project-visual { min-height: 420px; position: relative; overflow: hidden; display: grid; place-items: center; background: radial-gradient(circle at 50% 45%, rgba(95,123,210,.18), transparent 53%), #090b14; border-right: 1px solid var(--border); }
	.project-card:nth-child(even) .project-visual { border-right: 0; border-left: 1px solid var(--border); }
	.project-visual::after { content: ''; position: absolute; inset: 0; background: linear-gradient(130deg, transparent 35%, rgba(255,255,255,.035), transparent 65%); transform: translateX(-100%); transition: transform .8s ease; }
	.project-card:hover .project-visual::after { transform: translateX(100%); }
	.visual-grid { position: absolute; inset: 0; opacity: .2; background-image: linear-gradient(rgba(142,197,252,.15) 1px, transparent 1px), linear-gradient(90deg, rgba(142,197,252,.15) 1px, transparent 1px); background-size: 42px 42px; mask-image: linear-gradient(to bottom, transparent, #000 30%, #000 70%, transparent); }
	.project-number { position: absolute; left: 1.5rem; bottom: 1.2rem; font: 600 .72rem 'Space Grotesk'; color: rgba(255,255,255,.28); letter-spacing: .15em; }
	.project-copy { align-self: center; padding: clamp(2rem,5vw,4rem); }
	.project-category { color: var(--blue); text-transform: uppercase; letter-spacing: .16em; font-size: .69rem; font-weight: 600; margin-bottom: 1rem; }
	.project-copy h3 { font-size: clamp(1.8rem,3vw,2.8rem); letter-spacing: -.04em; margin-bottom: 1rem; }
	.project-description { color: #d5d8e4; line-height: 1.7; }
	.project-detail { color: var(--muted); line-height: 1.65; font-size: .88rem; margin-top: .85rem; }
	.tech-tags { display: flex; flex-wrap: wrap; gap: .45rem; margin-top: 1.4rem; list-style: none; }
	.tech-tags li { padding: .42rem .68rem; border: 1px solid var(--border); border-radius: 999px; color: #9fa5ba; background: rgba(255,255,255,.025); font-size: .69rem; }
	.project-link { display: inline-flex; align-items: center; gap: .6rem; margin-top: 1.7rem; font-size: .82rem; font-weight: 600; color: #e9ebf5; border-bottom: 1px solid rgba(142,197,252,.35); padding-bottom: .25rem; }
	.project-link svg { transition: transform .2s ease; }
	.project-link:hover svg { transform: translate(2px,-2px); }
	.commerce-ui, .paint-ui, .boat-ui { position: relative; width: 70%; max-width: 350px; aspect-ratio: 1.05; border: 1px solid rgba(142,197,252,.22); border-radius: 18px; background: rgba(8,11,21,.72); box-shadow: 0 22px 70px rgba(42,86,170,.2), inset 0 0 45px rgba(142,197,252,.04); transform: perspective(800px) rotateX(4deg) rotateY(-5deg); }
	.ui-top { height: 14%; display: flex; align-items: center; gap: 7px; padding: 0 9%; border-bottom: 1px solid rgba(142,197,252,.12); }
	.ui-top i { width: 9px; height: 9px; border-radius: 50%; background: #a8cfff; box-shadow: 0 0 13px #8ec5fc; }
	.ui-top span { width: 18%; height: 3px; border-radius: 5px; background: rgba(255,255,255,.16); margin-left: auto; }
	.ui-top span + span { margin-left: 2%; }
	.ui-product { display: grid; grid-template-columns: 1fr .7fr; gap: 10%; padding: 10% 9%; }
	.ui-product b { aspect-ratio: 1; border-radius: 10px; background: linear-gradient(140deg, rgba(200,167,255,.35), rgba(142,197,252,.08)); box-shadow: inset 0 0 30px rgba(200,167,255,.12); }
	.ui-product div { display: flex; flex-direction: column; gap: 12%; justify-content: center; }
	.ui-product i { height: 5px; border-radius: 5px; background: rgba(255,255,255,.16); }
	.ui-product i:nth-child(2) { width: 70%; }
	.ui-product i:nth-child(3) { height: 23px; width: 76%; background: linear-gradient(90deg, #bfa7f3, #7eb7ef); }
	.ui-cards { display: grid; grid-template-columns: repeat(3,1fr); gap: 6%; padding: 0 9%; }
	.ui-cards i { aspect-ratio: 1.15; border-radius: 7px; background: rgba(255,255,255,.055); border: 1px solid rgba(255,255,255,.06); }
	.visual-paint { background: radial-gradient(circle at 50% 45%, rgba(177,92,255,.15), transparent 55%), #0a0912; }
	.paint-ui { display: grid; grid-template-columns: 1fr .75fr; place-items: center; padding: 10%; transform: perspective(800px) rotateX(4deg) rotateY(5deg); }
	.paint-ring { position: relative; width: 88%; aspect-ratio: 1; border-radius: 50%; background: conic-gradient(#8ec5fc, #c593ff, #ff9fa5, #ffd67d, #8edfc7, #8ec5fc); box-shadow: 0 0 40px rgba(165,118,255,.18); }
	.paint-ring::after { content: ''; position: absolute; inset: 16%; border-radius: 50%; background: #0d0d1a; border: 1px solid rgba(255,255,255,.13); }
	.paint-ring i { position: absolute; z-index: 1; inset: 34%; border-radius: 50%; background: #bda6f5; box-shadow: 0 0 22px rgba(189,166,245,.5); }
	.paint-bars { width: 100%; display: flex; flex-direction: column; gap: 13px; }
	.paint-bars i { height: 7px; border-radius: 7px; background: linear-gradient(90deg, #a5ccff 72%, rgba(255,255,255,.07) 72%); }
	.paint-bars i:nth-child(2) { background: linear-gradient(90deg, #d6aaff 45%, rgba(255,255,255,.07) 45%); }
	.paint-bars i:nth-child(3) { background: linear-gradient(90deg, #ffb0b5 62%, rgba(255,255,255,.07) 62%); }
	.paint-bars i:nth-child(4) { background: linear-gradient(90deg, #ffe09c 30%, rgba(255,255,255,.07) 30%); }
	.visual-boat { background: radial-gradient(circle at 50% 45%, rgba(36,202,180,.14), transparent 55%), #070e14; }
	.boat-ui { display: grid; grid-template-columns: 1fr .45fr; place-items: center; padding: 8%; transform: perspective(800px) rotateX(5deg) rotateY(-4deg); }
